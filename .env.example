# Vim Connect app credentials (see CLAUDE.md "App registration" section).
# Copy to .env.local (gitignored) and fill in real values — never commit real values here.

# Server-side only (used by src/app/api/auth/token/route.ts for the code->token exchange).
VIM_CLIENT_ID=
VIM_CLIENT_SECRET=
# MUST match whatever EHR/sandbox environment you're actually testing against —
# a launch_id issued by one backend is meaningless to the other, and the
# authorize call will fail with "Invalid or expired launch ID" if these don't
# match (hit this for real 2026-08-04: sandbox-ehr.stage.getvim.ai issues
# launch_ids via api.stage.getvim.ai, not api.getvim.ai).
# https://api.getvim.ai (production) or https://api.stage.getvim.ai (staging)
VIM_BACKEND_URL=https://api.stage.getvim.ai

# Client-exposed (Next.js NEXT_PUBLIC_ vars are inlined into the browser bundle
# at build time — a real redeploy is required after changing these, not just a
# restart). client_id is not secret; this is the same value as VIM_CLIENT_ID
# above, just also readable client-side for src/lib/vim-auth-client.ts's
# redirect to Vim's /app-auth/authorize. Never put the client SECRET here.
# Must match VIM_BACKEND_URL above — same reasoning.
NEXT_PUBLIC_VIM_CLIENT_ID=
NEXT_PUBLIC_VIM_BACKEND_URL=https://api.stage.getvim.ai
